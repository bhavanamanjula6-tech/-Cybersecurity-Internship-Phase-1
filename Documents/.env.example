# ==============================================================================
# CyberOps SOC — Environment Configuration Specification
# ==============================================================================

# --- Application Runtime & Cloud Run Hosting ---
# APP_URL: The public canonical URL where this applet is hosted.
# Injected automatically by Cloud Run / AI Studio at runtime.
APP_URL="https://ais-dev-your-applet-id.asia-southeast1.run.app"

# PORT: The port the HTTP server binds to (default: 3000 in dev; injected by Cloud Run in production).
PORT=3000

# --- Public Client Configuration (Vite Exposed — Bundled into Frontend) ---
# NOTE: Only variables prefixed with VITE_ are exposed to browser code.
# Safe for client use ONLY when Row-Level Security (RLS) is active in PostgreSQL.

# VITE_SUPABASE_URL: The Supabase project HTTPS endpoint (from Supabase Dashboard -> Project Settings -> API).
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Client API Key:
# The frontend supports both variable names:
#   1. VITE_SUPABASE_ANON_KEY (standard convention)
#   2. VITE_SUPABASE_PUBLISHABLE_KEY (modern Supabase dashboard convention)
# Both accept modern publishable keys ("sb_publishable_...") as well as legacy JWT keys ("eyJhbGci...").
# Only one public key variable should normally be configured. If both are present,
# VITE_SUPABASE_ANON_KEY takes deterministic precedence for backward compatibility.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"
# VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-publishable-key"

# --- Confidential Server-Only Configuration (Node.js / server.ts ONLY) ---
# DANGER: NEVER prefix these variables with VITE_ and NEVER import them into React / src/ code!
# These values must be accessible exclusively by the backend Express process.

# SUPABASE_SERVICE_ROLE_KEY: Privileged administrative key that bypasses RLS.
# Used exclusively in server.ts for administrative role assignment and tamper-evident audit logging.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key"

# INITIAL_SUPER_ADMIN_EMAIL: The verified email address of the primary platform administrator.
# Used by the secure one-time bootstrap endpoint to grant the initial super_admin role.
INITIAL_SUPER_ADMIN_EMAIL="admin@yourdomain.com"

# GEMINI_API_KEY: Required for Gemini AI threat analysis and chatbot proxying.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
